# EXEMPLO de vhost para o Nginx QUE JA EXISTE na VPS (o proxy do 2M Prev).
#
# NAO substitui nada: e um ARQUIVO NOVO para /etc/nginx/sites-available/, ligado em
# sites-enabled, so para o dominio desta stack. Troque os dois marcadores:
#   __APP_DOMAIN__  o dominio escolhido (ex.: social.seudominio.com.br)
#   __HTTP_PORT__   o HTTP_PORT do deploy/vps/.env (padrao 8090)
#
# O HTTPS vem do Let's Encrypt pelo certbot do proprio host, depois que o DNS do
# dominio apontar para a VPS:
#   sudo certbot --nginx -d __APP_DOMAIN__
# O certbot acrescenta o bloco 443 e o redirect a ESTE arquivo — os outros sites
# nao sao tocados.
#
# Se o proxy da VPS nao for um Nginx do host (Traefik, Caddy, Nginx Proxy Manager em
# container), NAO use este arquivo: ver docs/DEPLOY-VPS.md, "Outros proxies".

server {
    listen 80;
    listen [::]:80;
    server_name __APP_DOMAIN__;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:__HTTP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
