# deploy/vps/.env — NUNCA versionado. Copie este arquivo, preencha, e guarde uma
# copia do APP_KEY e do DB_PASSWORD fora da VPS: sem o APP_KEY os tokens do Instagram
# criptografados no banco viram lixo, e um backup sem a chave nao restaura a conexao.

# --- Dominio (sem https://). Ainda nao ha um definitivo: escolha e aponte o DNS.
APP_DOMAIN=
# Porta LOCAL (127.0.0.1) onde o Nginx desta stack escuta. Confira na auditoria que
# esta livre. Nunca 80/443: essas sao do proxy que ja existe.
HTTP_PORT=8090

APP_NAME="2M Social AI"
# php artisan key:generate --show  (ou: docker compose run --rm app php artisan key:generate --show)
APP_KEY=
# Para trocar o APP_KEY sem perder os tokens: mova o antigo para ca.
APP_PREVIOUS_KEYS=

# --- Banco (so dentro do Docker; o usuario e o banco sao criados na 1a subida)
DB_DATABASE=2m_social_ai
DB_USERNAME=social
# openssl rand -base64 32
DB_PASSWORD=

# --- Acesso
# Cadastro fechado: so estes emails criam conta (separados por virgula).
REGISTRATION_ALLOWED_EMAILS=

# --- IA (ADR-06). `mock` nao gasta nada; `anthropic` exige a chave.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_WORKSPACE_MONTHLY_BUDGET_CENTS=2000

# --- Instagram (ADR-14). `fake` NAO publica nada de verdade. Trocar para `graph`
# so depois do app da Meta configurado e do piloto autorizado.
INSTAGRAM_DRIVER=fake
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0

# --- Publicacao
# Horario perdido ha mais que isto (worker parado) nao e publicado atrasado.
PUBLISHING_MAX_DELAY_MINUTES=720

# --- Backups (servico `backup`, pasta ./backups)
BACKUP_HOUR=04
BACKUP_RETENTION_DAYS=14
BACKUP_TZ=America/Sao_Paulo

# --- Recursos (ajuste depois da auditoria de memoria da VPS)
APP_MEM_LIMIT=512m
WORKER_MEM_LIMIT=384m
SCHEDULER_MEM_LIMIT=256m
DB_MEM_LIMIT=512m

LOG_LEVEL=info
APP_VERSION=latest
