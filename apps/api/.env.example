APP_NAME="2M Social AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=2m_social_ai
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- 2M Social AI ---
AI_PROVIDER=mock
AI_MODEL_DEFAULT=claude-opus-4-8
AI_WORKSPACE_MONTHLY_BUDGET_CENTS=5000
# Teto por projeto (= por marca). Vazio = so o do workspace.
AI_PROJECT_MONTHLY_BUDGET_CENTS=
# So o backend le. Nunca no frontend, nunca no Git. `php artisan ai:check` confere
# a configuracao sem chamar a API.
ANTHROPIC_API_KEY=
# timeout x (retries + 1) + ~10 s precisa caber nos 180 s do worker.
AI_TIMEOUT_SECONDS=75
AI_MAX_RETRIES=1
AI_MAX_INPUT_TOKENS=60000
AI_ALERT_RUN_COST_CENTS=100

# Emails separados por virgula que podem criar conta. Vazio = cadastro aberto
# (ok em dev). EM PRODUCAO, PREENCHER: com a IA real ligada, cadastro aberto
# significa qualquer um criando workspace e gastando a sua chave.
REGISTRATION_ALLOWED_EMAILS=

# Biblioteca de imagens. `public` num volume persistente (VPS); a Meta busca por URL publica.
MEDIA_DISK=public

# Imagem por IA (ADR-15). `fake` desenha sem rede; `openai` exige a chave.
# IMAGE_COST_CENTS: confira o preco por imagem do provedor antes de ligar.
IMAGE_PROVIDER=fake
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
IMAGE_COST_CENTS=5

# Instagram (ADR-14). `fake` conecta e publica de mentira; `graph` fala com a Meta.
INSTAGRAM_DRIVER=fake
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Identica a cadastrada no app da Meta. Padrao: ${APP_URL}/api/v1/instagram/callback
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_VERSION=v23.0
